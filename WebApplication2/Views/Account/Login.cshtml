@model WebApplication2.Models.LoginViewModel
@{
	ViewData["Title"] = "Sign in";
}

<h1>Sign in</h1>
<form asp-action="Login" method="post">
	<input asp-for="ReturnUrl" type="hidden" />
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>
	<div class="mb-3"><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" /><span asp-validation-for="Username" class="text-danger"></span></div>
	<div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger"></span></div>
	<button type="submit" class="btn btn-primary">Sign in</button>
	<a asp-action="Register" class="btn btn-link">Register</a>
</form>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
