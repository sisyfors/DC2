@model List<AccountSummaryDto>
@{
    var au = new System.Globalization.CultureInfo("en-AU");
}
<h2>My accounts</h2>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
<table class="table">
    <thead><tr><th>Account number</th><th>Type</th><th>Balance</th><th></th></tr></thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.AccountNumber</td>
                <td>@a.AccountType</td>
                <td>@((a.BalanceInCents / 100m).ToString("C", au))</td>
                <td><a asp-action="History" asp-route-accountNumber="@a.AccountNumber">History</a></td>
            </tr>
        }
    </tbody>
</table>