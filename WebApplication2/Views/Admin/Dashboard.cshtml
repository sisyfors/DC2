@model AuditPageDto
<h2>Administrator dashboard</h2>
<p><a asp-controller="AdminUsers" asp-action="Index">Manage users</a></p>
<h4>Audit trail</h4>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
<table class="table">
    <thead><tr><th>When</th><th>Admin</th><th>Action</th><th>Details</th></tr></thead>
    <tbody>
        @foreach (var a in Model.Items)
        {
            <tr><td>@a.Date.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@a.Admin</td><td>@a.Action</td><td>@a.Details</td></tr>
        }
    </tbody>
</table>
@if (Model.Page > 1)
{
    <a asp-action="Dashboard" asp-route-page="@(Model.Page - 1)">« Previous</a>
}
Page @Model.Page of @Model.TotalPages
@if (Model.Page < Model.TotalPages)
{
    <a asp-action="Dashboard" asp-route-page="@(Model.Page + 1)">Next »</a>
}